# Environment
NODE_ENV=development

PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_IDLE_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_AUTO_INDEX=true
SLOW_REQUEST_THRESHOLD_MS=800

# JWT Configuration
# IMPORTANT: Generate strong secret in production using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_secret
JWT_EXPIRES=7d

# Admin Account (for initial setup)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULLNAME=Director Admin

# Demo Accounts (only created if NODE_ENV != production)
# SECURITY: Do NOT use default password '123456' - set a strong password
DEMO_PASSWORD=ChangeThisDemoPass2024!

# Global throttling (requests/IP)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# AI Provider
# Do not commit real keys. Put the real value in local .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1400

# Redis / BullMQ
# Set true when you have Redis running and want async webhook processing.
REDIS_ENABLED=false
