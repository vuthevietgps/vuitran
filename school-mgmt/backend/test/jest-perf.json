{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.perf-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testTimeout": 300000,
  "reporters": [
    "default",
    ["jest-junit", {
      "outputDirectory": "../test-results/perf",
      "outputName": "junit.xml"
    }]
  ]
}
