{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testTimeout": 120000,
  "reporters": [
    "default",
    ["jest-junit", {
      "outputDirectory": "../test-results/e2e",
      "outputName": "junit.xml"
    }]
  ]
}
