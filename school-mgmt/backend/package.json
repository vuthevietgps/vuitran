{
  "name": "school-mgmt-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest --config ./test/jest-unit.json --runInBand",
    "test:unit": "jest --config ./test/jest-unit.json",
    "test:cov": "jest --config ./test/jest-unit.json --coverage",
    "test:watch": "jest --config ./test/jest-unit.json --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:perf": "jest --config ./test/jest-perf.json --runInBand",
    "test:perf:class-scale": "jest --config ./test/jest-perf.json --runInBand class-scale-load.perf-spec.ts",
    "test:coverage": "jest --config ./test/jest-e2e.json --coverage --runInBand",
    "test:financial-control-costs": "ts-node scripts/test-financial-control-costs.ts",
    "test:ads-financial-control-recalculation": "ts-node scripts/test-ads-financial-control-recalculation.ts",
    "test:expenses-financial-control-recalculation": "ts-node scripts/test-expenses-financial-control-recalculation.ts",
    "test:financial-control-loans": "ts-node scripts/test-financial-control-loans.ts",
    "test:financial-control-payroll": "ts-node scripts/test-financial-control-payroll.ts",
    "test:financial-control-payroll-recalculation": "ts-node scripts/test-financial-control-payroll-recalculation.ts",
    "test:attendance-payroll-financial-control": "ts-node scripts/test-attendance-payroll-financial-control.ts",
    "test:loans-activate": "ts-node scripts/test-loans-activate-status.ts",
    "test:loans-payment": "ts-node scripts/test-loans-payment-partial.ts",
    "test:class-attendance-pricing-workflow": "node scripts/test-class-attendance-pricing-workflow.js",
    "test:attendance-workflow": "node scripts/test-attendance-workflow.js",
    "test:teacher-payroll-ops-scenarios": "node scripts/test-teacher-payroll-ops-scenarios.js",
    "test:wallet-topup-workflow": "node scripts/test-wallet-topup-workflow.js",
    "test:e2e-ad-to-revenue": "node scripts/test-e2e-ad-to-revenue.js",
    "test:api-load": "node scripts/test-api-load.js",
    "test:uncovered-subsystems": "node scripts/test-uncovered-subsystems-workflow.js",
    "test:rbac-finance-guards": "node scripts/test-rbac-finance-guards.js",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:all:scripts": "node scripts/test-all.js",
    "test:all:with-load": "node scripts/test-all.js --with-load",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "postinstall": "node -e \"require('fs').existsSync('node_modules/.bin/nest')||process.exit(0)\""
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@types/cookie-parser": "^1.4.10",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.71.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "mongoose": "^8.0.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.37",
    "@types/supertest": "^6.0.2",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.2"
  }
}
