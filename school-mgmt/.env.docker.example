# Copy this file to .env before running docker compose, then customize values.
MONGODB_URI=mongodb://mongo:27017/school-mgmt?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_IDLE_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_AUTO_INDEX=false
SLOW_REQUEST_THRESHOLD_MS=800
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

JWT_SECRET=replace_with_strong_jwt_secret_for_local
JWT_EXPIRES=7d
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULLNAME=Director Admin
DEMO_PASSWORD=Demo123456!
DEMO_SYNC_EXISTING=true
