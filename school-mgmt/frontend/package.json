{
  "name": "school-mgmt-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "e2e:ui": "playwright test -c playwright.config.ts",
    "e2e:ui:report": "playwright show-report ../test-results/e2e-ui/html",
    "e2e:ui:orchestrator": "playwright test -c playwright.config.ts e2e/orchestrator",
    "e2e:ui:orchestrator:list": "playwright test -c playwright.config.ts e2e/orchestrator --list",
    "e2e:ui:headed": "playwright test -c playwright.config.ts --headed",
    "e2e:inventory": "node scripts/classify-playwright-specs.js",
    "e2e:evidence:collect": "node scripts/collect-evidence.js",
    "e2e:evidence:quarantine": "node scripts/quarantine-unsafe-evidence.js collect-evidence",
    "evidence:mark-pass": "node scripts/mark-logs-pass.js",
    "evidence:quarantine": "node scripts/quarantine-unsafe-evidence.js mark-logs-pass",
    "generate:internal-handbook-assets": "node ./scripts/generate-internal-handbook-assets.mjs",
    "sync:teacher-docs": "node ./scripts/sync-teacher-docs-to-assets.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.0",
    "@playwright/test": "^1.52.0",
    "@types/jasmine": "~5.1.0",
    "baseline-browser-mapping": "^2.10.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2"
  }
}
